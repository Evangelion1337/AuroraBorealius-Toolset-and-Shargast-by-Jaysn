For download info, please visit:
http://nwvault.ign.com/View.php?view=Other.Detail&id=4683&id=625    */

//Put this script OnOpen
void main()
{
DelayCommand(2.0, ActionCloseDoor(OBJECT_SELF));

object oPC = GetLastOpenedBy();

if (!GetIsPC(oPC)) return;

if (GetHitDice(oPC) < 7)
   {
   sDeny="This area is meant for PC's less than 7th level.";

   SendMessageToPC(oPC, sDeny);

   return;
   }

object oTarget;
location lTarget;
oTarget = GetWaypointByTag("WP_ST_CHEAT1");

lTarget = GetLocation(oTarget);

//only do the jump if the location is valid.
//though not flawless, we just check if it is in a valid area.
//the script will stop if the location isn't valid - meaning that
//nothing put after the teleport will fire either.
//the current location won't be stored, either

if (GetAreaFromLocation(lTarget)==OBJECT_INVALID) return;

AssignCommand(oPC, ClearAllActions());

AssignCommand(oPC, ActionJumpToLocation(lTarget));

FloatingTextStringOnCreature("This area is meant for 7th level PC's and below.", oPC);

}

