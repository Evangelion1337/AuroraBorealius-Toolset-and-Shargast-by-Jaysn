void main()
{
object oPC;

if (!GetIsPC(GetItemActivatedTarget())
|| (GetObjectType(GetItemActivatedTarget())!=OBJECT_TYPE_CREATURE)
|| (GetObjectType(GetItemActivatedTarget())!=OBJECT_TYPE_PLACEABLE)
|| (GetObjectType(GetItemActivatedTarget())!=OBJECT_TYPE_DOOR)
){

SendMessageToPC(GetItemActivator(), "Improper use of item!");
return;}

object oTarget;
oTarget = GetItemActivatedTarget();

effect eEffect;
eEffect = EffectKnockdown();

eEffect = ExtraordinaryEffect(eEffect);

ApplyEffectToObject(DURATION_TYPE_TEMPORARY, eEffect, oTarget, 5.0f);

//Visual effects can't be applied to waypoints, so if it is a WP
//the VFX will be applied to the WP's location instead

int nInt;
nInt = GetObjectType(oTarget);

if (nInt != OBJECT_TYPE_WAYPOINT) ApplyEffectToObject(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_IMP_DUST_EXPLOSION), oTarget);
else ApplyEffectAtLocation(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_IMP_DUST_EXPLOSION), GetLocation(oTarget));

}
