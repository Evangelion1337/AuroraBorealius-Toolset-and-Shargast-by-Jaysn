//Put this on action taken in the conversation editor
#include "nw_i0_tool"
void main()
{
    // Give the speaker the items
    CreateItemOnObject("blackknightsig", GetPCSpeaker(), 1);
    CreateItemOnObject("blackknightskey", GetPCSpeaker(), 1);
    CreateItemOnObject("blackkightsst", GetPCSpeaker(), 1);

object oPC = GetPCSpeaker();

object oTarget;
oTarget = oPC;

//Visual effects can't be applied to waypoints, so if it is a WP
//the VFX will be applied to the WP's location instead

int nInt;
nInt = GetObjectType(oTarget);

if (nInt != OBJECT_TYPE_WAYPOINT) ApplyEffectToObject(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_FNF_SUMMON_UNDEAD), oTarget);
else ApplyEffectAtLocation(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_FNF_SUMMON_UNDEAD), GetLocation(oTarget));

//Visual effects can't be applied to waypoints, so if it is a WP
//the VFX will be applied to the WP's location instead

nInt = GetObjectType(oTarget);

if (nInt != OBJECT_TYPE_WAYPOINT) ApplyEffectToObject(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_IMP_DEATH_WARD), oTarget);
else ApplyEffectAtLocation(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_IMP_DEATH_WARD), GetLocation(oTarget));

RewardPartyXP(800, oPC, FALSE);

RewardPartyGP(2000, oPC, FALSE);

}

