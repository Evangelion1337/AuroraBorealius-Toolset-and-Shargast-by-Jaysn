AssignCommand(oCaster, ActionCastSpellAtObject(SPELL_INVISIBILITY, oTarget, METAMAGIC_ANY, TRUE, 5, PROJECTILE_PATH_TYPE_DEFAULT, TRUE));

oTarget = oPC;

//Visual effects can't be applied to waypoints, so if it is a WP
