//Put this on action taken in the conversation editor
void main()
{

object oPC = GetPCSpeaker();

AssignCommand(oPC, TakeGoldFromCreature(100, oPC, TRUE));

object oTarget;
oTarget = GetObjectByTag("mighty_anvil");

//Visual effects can't be applied to waypoints, so if it is a WP
//apply to the WP's location instead

int nInt;
nInt = GetObjectType(oTarget);

if (nInt != OBJECT_TYPE_WAYPOINT) ApplyEffectToObject(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_FNF_STRIKE_HOLY), oTarget);
else ApplyEffectAtLocation(DURATION_TYPE_INSTANT, EffectVisualEffect(VFX_FNF_STRIKE_HOLY), GetLocation(oTarget));

AssignCommand(GetObjectByTag("mighty_anvil"), ActionSpeakString("Thank you my follower your donation will help our cause."));

AdjustAlignment(oPC, ALIGNMENT_GOOD, 10);

}

